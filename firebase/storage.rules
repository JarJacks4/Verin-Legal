rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    // Profile photos and other per-user uploads.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    // Evidence originals and record exports are written only by Cloud
    // Functions. Signed-in users may read them directly; the app normally
    // uses the tokenized download URLs the functions return.
    match /matters/{matterId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
