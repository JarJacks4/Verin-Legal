rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default: nothing is readable or writable unless a rule below allows it.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile photos.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Evidence uploads land here first (up to 2 GB per file). The
    // ingestEvidence function hashes the exact bytes, moves them under
    // matters/, and deletes this temporary copy.
    match /intake/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 2 * 1024 * 1024 * 1024;
    }

    // Evidence originals and record exports: written only by Cloud Functions.
    match /matters/{matterId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
