rules_version = '2';

// Verin Legal — Firestore security rules.
//
// Firms are separated here, on the server: every record carries the firmID
// it belongs to, and a signed-in user can only read or change records whose
// firmID matches users/{uid}.firmID. That field — and the user's role — are
// written only by the setupAccount Cloud Function, never by the app.
//
// Evidence integrity rule of thumb: anything that is part of the record
// (receipts, the hash chain, exports, extraction runs, Clio sync history) is
// written only by Cloud Functions through the Admin SDK, which bypasses these
// rules. Staff can read their own firm's records but cannot create, edit or
// delete them.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myFirm() {
      return me().get('firmID', '');
    }

    // True when `firm` is the signed-in user's own (non-empty) firm.
    function inMyFirm(firm) {
      return signedIn() && firm is string && firm != '' && firm == myFirm();
    }

    function isAdmin() {
      return me().get('role', '').lower() in ['admin', 'owner', 'administrator'];
    }

    // True if the update leaves every listed field unchanged.
    function untouched(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function matterFirm(matterId) {
      return get(/databases/$(database)/documents/Matters/$(matterId)).data.get('firmID', '');
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Firm membership and role come only from setupAccount.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['firmID', 'firmId', 'role']);
      allow update: if signedIn() && request.auth.uid == uid
        && untouched(['firmID', 'firmId', 'role']);
      allow delete: if false;
    }

    match /Matters/{matterId} {
      allow read: if inMyFirm(resource.data.firmID);
      allow create: if inMyFirm(request.resource.data.get('firmID', ''))
        && !request.resource.data.keys().hasAny(['chainHeadHash', 'chainLength', 'hasChainRoot']);
      // Firm, chain and integration fields are server-maintained.
      allow update: if inMyFirm(resource.data.firmID) && untouched([
        'firmID',
        'chainHeadHash', 'chainLength', 'hasChainRoot',
        'clioMatterID', 'clioConnected', 'clioSyncedAt', 'clioMatterUrl', 'clioMatterDisplayNumber',
        'providerMatterReference', 'providerSyncedAt',
        'lastExportPath', 'lastExportSha256', 'lastExportAt',
        'batesNext', 'productionCount',
        'demo', 'lastDeliveryAt', 'lastStandingExportAt', 'archiveBuildStartedAt',
        'intakeProvisionAlertedAt'
      ]);
      allow delete: if false;

      match /exports/{exportId} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }

      // Server-written: deliveries to the firm's system (#16), weekly digests
      // (#70), closed-matter imports (#4) and AI usage (#53, #76).
      match /deliveries/{id} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }
      match /digests/{id} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }
      match /archiveImports/{id} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }
      match /aiUsage/{id} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }

      // Server-built views of the record: the reconstructed thread
      // (derived/thread) and what each new item changed (updates/{receipt}).
      match /derived/{docId} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }
      match /updates/{updateId} {
        allow read: if inMyFirm(matterFirm(matterId));
        allow write: if false;
      }

      // Exhibit productions. Staff edit drafts (items, order, reviewed
      // redactions); only the produceExhibits function makes one final, and a
      // final version never changes.
      match /productions/{productionId} {
        function finalFields() {
          return ['version', 'finalizedAt', 'finalizedBy', 'finalizedByName', 'batesStart', 'batesEnd',
                  'pageCount', 'template', 'exhibits', 'files'];
        }
        allow read: if inMyFirm(matterFirm(matterId));
        allow create: if inMyFirm(matterFirm(matterId))
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && !request.resource.data.keys().hasAny(finalFields());
        allow update: if inMyFirm(matterFirm(matterId))
          && resource.data.status == 'draft' && request.resource.data.status == 'draft'
          && untouched(finalFields().concat(['createdBy', 'createdAt']));
        allow delete: if inMyFirm(matterFirm(matterId)) && resource.data.status == 'draft';
      }
    }

    match /Receipts/{receiptId} {
      allow read: if inMyFirm(resource.data.firmID);
      // Receipts are created by Cloud Functions (server-side hashing and
      // chaining). Staff may only change review labels on them.
      allow create, delete: if false;
      // Quarantined items change only through approveQuarantined.
      allow update: if inMyFirm(resource.data.firmID)
        && resource.data.get('extractionState', '') != 'quarantined'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['classificationLabel', 'isTranscribed', 'resolvedDate', 'hasChronologyShift',
                    'reviewedByUid', 'reviewedAt']);

      match /extractionRuns/{runId} {
        allow read: if inMyFirm(get(/databases/$(database)/documents/Receipts/$(receiptId)).data.get('firmID', ''));
        allow write: if false;
      }
    }

    // Thread annotations: the firm's notes on reconstructed messages. Work
    // product beside the evidence; nothing here touches a receipt or the chain.
    match /Annotations/{id} {
      function validNote(d) {
        return d.text is string && d.text.size() > 0 && d.text.size() <= 4000
          && d.tag in ['note', 'key', 'followup', 'question'];
      }
      function isAuthorOrAdmin() {
        return resource.data.authorUid == request.auth.uid || isAdmin();
      }
      allow read: if inMyFirm(resource.data.firmID);
      allow create: if inMyFirm(request.resource.data.get('firmID', ''))
        && request.resource.data.authorUid == request.auth.uid
        && get(request.resource.data.matterId).data.get('firmID', '') == request.resource.data.firmID
        && validNote(request.resource.data);
      allow update: if inMyFirm(resource.data.firmID) && isAuthorOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'tag', 'updatedAt'])
        && validNote(request.resource.data);
      allow delete: if inMyFirm(resource.data.firmID) && isAuthorOrAdmin();
    }

    // Reviewer corrections to the AI's reading. Append-only: a newer
    // correction supersedes an older one, and the history stays.
    match /Corrections/{id} {
      allow read: if inMyFirm(resource.data.firmID);
      allow create: if inMyFirm(request.resource.data.get('firmID', ''))
        && request.resource.data.byUid == request.auth.uid
        && get(request.resource.data.matterId).data.get('firmID', '') == request.resource.data.firmID
        && request.resource.data.field in ['text', 'date', 'sender', 'thread']
        && request.resource.data.corrected is string
        && request.resource.data.corrected.size() > 0 && request.resource.data.corrected.size() <= 4000;
      allow update, delete: if false;
    }

    // Missing-evidence requests: drafted from the record's gaps, edited and
    // approved by staff, sent from their own email. Verin never sends them.
    match /FollowUps/{id} {
      allow read: if inMyFirm(resource.data.firmID);
      allow create: if inMyFirm(request.resource.data.get('firmID', ''))
        && request.resource.data.createdBy == request.auth.uid
        && get(request.resource.data.matterId).data.get('firmID', '') == request.resource.data.firmID
        && request.resource.data.status in ['draft', 'sent', 'dismissed'];
      allow update: if inMyFirm(resource.data.firmID)
        && untouched(['firmID', 'matterId', 'key', 'createdBy', 'createdAt'])
        && request.resource.data.status in ['draft', 'sent', 'dismissed', 'resolved'];
      allow delete: if false;
    }

    // Usage and review events for the value report. The server logs reading;
    // staff sessions log their own review time and corrections.
    match /Activity/{id} {
      allow read: if inMyFirm(resource.data.firmID) && isAdmin();
      allow create: if inMyFirm(request.resource.data.get('firmID', ''))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['review', 'correction', 'follow_up_sent', 'export', 'view'];
      allow update, delete: if false;
    }

    match /chainEntries/{entryId} {
      allow read: if inMyFirm(resource.data.firmID);
      allow write: if false;
    }

    match /clioSyncLog/{logId} {
      allow read: if inMyFirm(resource.data.firmID);
      allow write: if false;
    }

    // Firm profile and preferences are editable by the firm's admins in
    // Settings; the firm itself is created by setupAccount, and plan and
    // billing fields are set by Verin (console / Admin SDK).
    match /firmAccount/{id} {
      function planFields() {
        return ['planName', 'planStatus', 'planPriceCents', 'planRenewsAt', 'memberSince',
                'seatLimit', 'storageTier', 'retentionPolicy'];
      }
      allow read: if inMyFirm(resource.data.firmID);
      allow create, delete: if false;
      allow update: if inMyFirm(resource.data.firmID) && isAdmin() && (
        untouched(planFields().concat(['firmID', 'ownerUid', 'isDemo', 'demoResetting', 'demoSeededAt', 'demoSeededBy', 'smsNumber',
          'smsNumberAssignedAt', 'smsNumberFromPool',
          'baselineRecordLag', 'baselineRecordLagLockedAt', 'baselineRecordLagAttempt']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retentionPolicy', 'retentionRequest'])
            && request.resource.data.get('retentionPolicy', 'standard') == 'standard'));

      match /invoices/{invoiceId} {
        allow read: if inMyFirm(get(/databases/$(database)/documents/firmAccount/$(id)).data.get('firmID', ''));
        allow write: if false;
      }

      // Firm alerts (provisioning, oversize sends, delivery failures): staff
      // read them and mark them resolved; only the server raises them.
      match /alerts/{alertId} {
        allow read: if inMyFirm(get(/databases/$(database)/documents/firmAccount/$(id)).data.get('firmID', ''));
        allow update: if inMyFirm(get(/databases/$(database)/documents/firmAccount/$(id)).data.get('firmID', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedByUid', 'resolvedAt'])
          && request.resource.data.resolved == true;
        allow create, delete: if false;
      }
      // Generated reports, exit exports and demo deletion confirmations.
      match /reports/{reportId} {
        allow read: if inMyFirm(get(/databases/$(database)/documents/firmAccount/$(id)).data.get('firmID', ''));
        allow write: if false;
      }
      match /exitExports/{exportId} {
        allow read: if isAdmin() && inMyFirm(get(/databases/$(database)/documents/firmAccount/$(id)).data.get('firmID', ''));
        allow write: if false;
      }
      match /demoDeletions/{logId} {
        allow read: if inMyFirm(get(/databases/$(database)/documents/firmAccount/$(id)).data.get('firmID', ''));
        allow write: if false;
      }
    }

    // Weekly cost to serve (#53): Verin's own staff only.
    match /costReports/{id} {
      allow read: if signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@verinlegal[.]com$');
      allow write: if false;
    }

    // Team list and invitations. Admins invite and remove; joining a firm
    // happens through setupAccount, which checks the invitation's email.
    match /TeamMembers/{id} {
      allow read: if inMyFirm(resource.data.firmID);
      allow create: if isAdmin() && inMyFirm(request.resource.data.get('firmID', ''))
        && request.resource.data.get('status', '') == 'invited'
        && !request.resource.data.keys().hasAny(['uid']);
      allow update: if isAdmin() && inMyFirm(resource.data.firmID)
        && untouched(['firmID', 'uid', 'email']);
      allow delete: if isAdmin() && inMyFirm(resource.data.firmID);
    }

    // Clio connection status the app displays; written by the Clio functions.
    match /integrationStatus/{firmId} {
      allow read: if inMyFirm(firmId);
      allow write: if false;
    }

    // Server only: encrypted OAuth tokens, one-time OAuth state values and
    // per-firm migration markers.
    match /integrationSecrets/{id} {
      allow read, write: if false;
    }
    match /oauthStates/{id} {
      allow read, write: if false;
    }
    // Client email / text intake (verin/intake): server-only, except that a
    // firm sees texts from numbers it doesn't know yet, to file them.
    match /InboundEvents/{id} {
      allow read, write: if false;
    }
    match /intakeAddresses/{id} {
      allow read, write: if false;
    }
    match /UnroutedIntake/{id} {
      allow read: if inMyFirm(resource.data.firmID);
      allow write: if false;
    }

    // Timed demo runs: a demo workspace logs and reads its own.
    match /demoRuns/{id} {
      allow read: if inMyFirm(resource.data.firmID);
      allow create: if inMyFirm(request.resource.data.get('firmID', ''))
        && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.status == 'running';
      allow update: if inMyFirm(resource.data.firmID)
        && untouched(['firmID', 'startedBy', 'startedAt'])
        && request.resource.data.status in ['running', 'done', 'discarded'];
      allow delete: if false;
    }

    // Service status strip shown on every screen during an incident. Set
    // from the Firebase console only.
    match /systemStatus/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /firmScope/{id} {
      allow read, write: if false;
    }

    // Collections from the original FlutterFlow build. The current app
    // doesn't use them and they carry no firm, so they are closed.
    match /Items/{itemId=**} {
      allow read, write: if false;
    }
    match /VerifiedStatements/{id} {
      allow read, write: if false;
    }
    match /Sync_Status/{id} {
      allow read, write: if false;
    }
    match /Follow-UpRequests/{id} {
      allow read, write: if false;
    }
  }
}
