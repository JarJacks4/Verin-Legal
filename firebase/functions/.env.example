# Copy to firebase/functions/.env. These are NOT secrets; secrets go in Google Secret Manager.
# Only if your Anthropic key was created outside a workspace: the workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_MAX_TOKENS=16000
VIDEO_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global
TSA_URL=http://timestamp.digicert.com
TSA_NAME=DigiCert
DEFAULT_FIRM_ID=harbow-law
# Clio (fill in CLIO_CLIENT_ID after registering the app in the Clio developer portal)
CLIO_CLIENT_ID=
CLIO_REGION=us
CLIO_REDIRECT_URI=https://us-central1-verin-legal-fbzp5w.cloudfunctions.net/clioOAuthCallback
APP_URL=https://verin-legal-fbzp5w.web.app
# Optional: route Clio calls through Verin's own static IP (see DEPLOYMENT.md, "Clio and a static IP")
CLIO_VPC_CONNECTOR=
# Client email and text intake (see DEPLOYMENT.md, "Email and text intake")
INBOUND_EMAIL_DOMAIN=in.verinlegal.com
TWILIO_ACCOUNT_SID=
TWILIO_SMS_NUMBER=
TWILIO_WEBHOOK_URL=https://us-central1-verin-legal-fbzp5w.cloudfunctions.net/inboundSms
SMS_AUTO_REPLY=false
WHATSAPP_ENABLED=false
# Separate demo intake (#1): prospects' messages only ever reach NFR demo workspaces.
# Leave empty and demo matters show sample addresses.
DEMO_INBOUND_EMAIL_DOMAIN=
DEMO_TWILIO_SMS_NUMBER=
# Number pool (#15): comma-separated Twilio numbers, one handed to each firm without its own.
TWILIO_NUMBER_POOL=
# Outbound email (receipts to clients, digests, demo deletion confirmations).
# Turn on only after the EMAIL_API_KEY secret exists (see DEPLOYMENT.md, "Outbound email").
EMAIL_ENABLED=false
EMAIL_PROVIDER=postmark
EMAIL_FROM=Verin Legal <no-reply@verinlegal.com>
EMAIL_AUTO_REPLY=false
# Cost to serve (#53): $ per million tokens / per message / per GB-month.
COST_AI_INPUT_PER_MTOK=3
COST_AI_OUTPUT_PER_MTOK=15
COST_SMS_PER_MESSAGE=0.0083
COST_EMAIL_PER_MESSAGE=0.0012
COST_STORAGE_PER_GB_MONTH=0.026
# Nightly Firestore backup (#31): a separate bucket, e.g. verin-legal-fbzp5w-backups. Empty = off.
BACKUP_BUCKET=
