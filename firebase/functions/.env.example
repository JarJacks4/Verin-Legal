# Copy to firebase/functions/.env. These are NOT secrets; secrets go in Google Secret Manager.
# Only if your Anthropic key was created outside a workspace: the workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_MAX_TOKENS=16000
VIDEO_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global
TSA_URL=http://timestamp.digicert.com
TSA_NAME=DigiCert
DEFAULT_FIRM_ID=harbow-law
# Clio (fill in CLIO_CLIENT_ID after registering the app in the Clio developer portal)
CLIO_CLIENT_ID=
CLIO_REGION=us
CLIO_REDIRECT_URI=https://us-central1-verin-legal-fbzp5w.cloudfunctions.net/clioOAuthCallback
APP_URL=https://verin-legal-fbzp5w.web.app
# Optional: route Clio calls through Verin's own static IP (see DEPLOYMENT.md, "Clio and a static IP")
CLIO_VPC_CONNECTOR=
