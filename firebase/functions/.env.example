# Copy to firebase/functions/.env and fill in. These are NOT secrets.
# Secrets (ANTHROPIC_API_KEY, CLIO_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY) are set with
#   firebase functions:secrets:set NAME
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_MAX_TOKENS=16000
DEFAULT_FIRM_ID=harbow-law
# Clio (fill in after registering the app in the Clio developer portal)
CLIO_CLIENT_ID=
CLIO_REGION=us
CLIO_REDIRECT_URI=https://us-central1-verin-legal-fbzp5w.cloudfunctions.net/clioOAuthCallback
APP_URL=
